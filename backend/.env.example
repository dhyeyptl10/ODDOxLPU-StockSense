# Local development. Copy missing values into backend/.env; never commit secrets.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Generate a private key: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; use at least 32 random characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d
INVENTORY_TIMEZONE=Asia/Kolkata
# Optional absolute database path. Default: backend/db/coreinventory.db
DB_PATH=

# Email OTP: example Gmail SMTP settings. Fill with your own sending account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# WhatsApp OTP: Twilio approved WhatsApp sender and authentication template.
# Template variable {{1}} must be the OTP. Never place these secrets in VITE_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_OTP_CONTENT_SID=
